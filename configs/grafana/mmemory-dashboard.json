{
  "dashboard": {
    "id": null,
    "title": "MMemory 性能监控面板",
    "tags": ["mmemory", "telegram", "bot", "performance"],
    "style": "dark",
    "timezone": "Asia/Shanghai",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "schemaVersion": 38,
    "version": 5,
    "links": [],
    "panels": [
      {
        "id": 1,
        "title": "系统概览",
        "type": "row",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "系统运行时间",
        "type": "stat",
        "targets": [
          {
            "expr": "mmemory_system_uptime_seconds",
            "legendFormat": "运行时间",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
        }
      },
